# VRMS backend configuration. Copy to backend/.env and edit.
# Read by config/settings/*.py through django-environ. Never commit .env.

# ─── Django ──────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Reverse proxies in front of Django (0 locally, 1 behind Caddy in production).
NUM_PROXIES=0

# ─── Database (matches docker-compose.yml) ───────────────
# If POSTGRES_HOST_PORT is set in the root .env, use that port here.
DATABASE_URL=postgres://vrms:vrms_dev_password@localhost:5432/vrms

# ─── Celery broker and result backend (Valkey, D2) ───────
REDIS_URL=redis://localhost:6379/0

# ─── Agency (D7) ─────────────────────────────────────────
AGENCY_NAME=[Agency Name]
CURRENCY=INR
# Pay.Invoice: printed on every invoice (e.g. the GSTIN).
AGENCY_TAX_REGISTRATION=

# ─── Payment gateway (sandbox only, CO-7) ────────────────
PAYMENT_GATEWAY_BACKEND=mock
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=

# ─── Notification service (sandbox only, CO-7) ───────────
NOTIFICATION_BACKEND=mock
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# ─── Documents ───────────────────────────────────────────
MEDIA_URL_EXPIRY_SECONDS=900

# ─── Production only (config.settings.production) ────────
SECURE_HSTS_SECONDS=31536000
